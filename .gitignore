#################################
# PaletteMonkey
#
# Standalone: this file does not depend on any global ignore file, so a
# fresh clone on any machine ignores the right things.
#################################

#################################
# macOS
#################################
.DS_Store
.AppleDouble
.LSOverride
__MACOSX

#################################
# Xcode - user state
#################################
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Workspace *state* only. project.xcworkspace itself is tracked - it carries
# contents.xcworkspacedata and xcshareddata/swiftpm/Package.resolved.
**/*.xcworkspace/xcuserdata/
**/*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

#################################
# Build products
#################################
DerivedData/
*.preview-thumbnails/
.build/
.swiftpm/

# xcodebuild can emit a build/ alongside the project. Anchored on purpose:
# a bare "build/" would also swallow any source directory of that name.
Xcode/PaletteMonkey/build/

#################################
# Editor
#################################
*.swp
*.swo
*.tmp
.idea/
**/.claude/settings.local.json

#################################
# Tracked on purpose
#
# Lockfiles pin exact dependency versions and must be committed so every
# machine and CI resolve identically. These negations are defensive: they
# override a stale global ignore file on someone else's machine.
#################################
!Package.resolved
!Podfile.lock
